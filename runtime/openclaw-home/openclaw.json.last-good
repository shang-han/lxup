{
  "agents": {
    "defaults": {
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    },
    "list": [
      {
        "id": "main",
        "workspace": "runtime/workspace"
      }
    ]
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "dev-local-token"
    },
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "models": {
    "providers": {}
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1-2",
    "lastTouchedAt": "2026-08-13T07:38:17.918Z"
  },
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      },
      "qqbot": {
        "enabled": true
      },
      "openclaw-weixin": {
        "enabled": true
      },
      "wecom-openclaw-plugin": {
        "enabled": true
      }
    },
    "load": {
      "paths": [
        "runtime/openclaw-home/plugins/deepseek/node_modules/@openclaw/deepseek-provider",
        "runtime/openclaw-home/plugins/qqbot/node_modules/@openclaw/qqbot",
        "runtime/openclaw-home/plugins/weixin/node_modules/@tencent-weixin/openclaw-weixin",
        "runtime/openclaw-home/plugins/wecom/node_modules/@wecom/wecom-openclaw-plugin"
      ]
    }
  },
  "bindings": [],
  "channels": {},
  "auth": {
    "profiles": {
      "deepseek:manual": {
        "provider": "deepseek",
        "mode": "api_key"
      },
      "deepseek_2:manual": {
        "provider": "deepseek_2",
        "mode": "api_key"
      },
      "dashscope:manual": {
        "provider": "dashscope",
        "mode": "api_key"
      }
    }
  }
}
